{
  "name": "plans",
  "private": true,
  "description": "Browser tests for the cupboard planner. The site itself has no dependencies or build step.",
  "scripts": {
    "serve": "python3 serve.py",
    "test": "playwright test",
    "test:quick": "playwright test --project=iphone",
    "test:update": "playwright test --update-snapshots",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
