{
  "name": "plans",
  "private": true,
  "description": "Tests for the cupboard planner: the model's in Node (test:model), the page's in browsers. The site itself has no dependencies or build step.",
  "scripts": {
    "prepare": "git config core.hooksPath githooks",
    "serve": "python3 serve.py",
    "test": "playwright test",
    "test:quick": "playwright test --project=iphone",
    "test:update": "playwright test --update-snapshots",
    "test:model": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'tests/model/*.test.mjs'",
    "regen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/model/regenerate.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "three": "0.160.0"
  }
}
